# Functional Tool — configuration.
#
# Copy to .env for local development. On Vercel these are set in the project's
# Environment Variables; nothing here is read from the repository.
#
# NOTHING IN THIS FILE IS A REAL CREDENTIAL. Replace every placeholder.

# ---------------------------------------------------------------
# Database
#
# Use the TRANSACTION pooler (port 6543), not the direct connection (5432).
# Serverless opens a connection per cold start and would exhaust the direct
# pool. Supabase: Project Settings -> Database -> Connection string -> URI,
# under "Transaction pooler".
# ---------------------------------------------------------------
DATABASE_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Local development against a plain Postgres:
# DATABASE_URL=postgres://localhost:5432/functional_tool

# ---------------------------------------------------------------
# Supabase
#
# SERVICE_ROLE_KEY bypasses row-level security and can create users. It is a
# server-only secret: never expose it to a browser, never commit it.
# ---------------------------------------------------------------
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=attachments

# Only needed if the project still signs JWTs with the legacy shared secret
# rather than asymmetric keys. Leave blank otherwise.
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------
# Application
# ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Shared secret for POST /api/internal/cron, called by pg_cron.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

MIN_PASSWORD_LENGTH=10
SESSION_MAX_AGE_SECONDS=1209600
AUDIT_RETENTION_DAYS=730
MAX_UPLOAD_BYTES=10485760
JSON_BODY_LIMIT=256kb

# ---------------------------------------------------------------
# Mail
#
# `log` writes a .eml into data/outbox/ and sends nothing — the default, and
# what the tests run against. `smtp` sends for real.
# ---------------------------------------------------------------
MAIL_TRANSPORT=log
MAIL_FROM=Functional Tool <noreply@example.com>

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Staging safety net: with SMTP configured, only these addresses are sent to.
# Everything else is recorded as skipped. Leave blank to allow all.
MAIL_ALLOWLIST=

# Local only. On Vercel pg_cron drives the outbox instead; set to `off` to
# disable the in-process timer.
MAIL_WORKER_MS=15000

# ---------------------------------------------------------------
# Seed — used by scripts/seed.js only, never read at runtime
# ---------------------------------------------------------------
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_JOB_TITLE=Product Manager

SEED_PARTNER_NAME=Partner POC
SEED_PARTNER_EMAIL=partner@example.com
SEED_PARTNER_PASSWORD=
SEED_PARTNER_JOB_TITLE=Partner Program Manager
